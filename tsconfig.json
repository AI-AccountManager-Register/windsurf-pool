{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "out",
    "rootDir": ".",
    "sourceMap": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "removeComments": false,
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*",
    "out/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "out/**/*.d.ts",
    "out/out/**",
    "orderProject",
    "docs",
    "scripts/**/*"
  ]
}
